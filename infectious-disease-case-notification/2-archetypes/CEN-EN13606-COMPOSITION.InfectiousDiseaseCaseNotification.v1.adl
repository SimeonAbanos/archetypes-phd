archetype (adl_version=1.4)
    CEN-EN13606-COMPOSITION.InfectiousDiseaseCaseNotification.v1

concept
    [at0000]

language
    original_language = <[ISO_639-1::en]>

description
    original_author = <
        ["date"] = <"2026-09-20">
        ["name"] = <"Simeon Abanos">
        ["organisation"] = <"FMI, Sofia University St. Kliment Ohridski">
    >
    lifecycle_state = <"Draft">
    details = <
        ["en"] = <
            language = <[ISO_639-1::en]>
            purpose = <"Record a rapid notification of a case of an infectious disease, as a general practitioner submits it under Ordinance No 21 of 18 July 2005 on the procedure for registration, notification and reporting of communicable diseases, structured in four sections: the subject, the disease, the classification of the case with the grounds that produced it, and the reporter.">
            use = <"Built within the doctoral thesis on 2026-09-20, from Ordinance No 21 of 18 July 2005, consolidated text as amended in State Gazette No 35 of 14 April 2026, as that text is held in the database of the information system for registration, notification and reporting of communicable diseases. The vocabulary and the recording style follow CEN-EN13606-COMPOSITION.PATIENT.v1; terminologies are bound through codingSchemeName in the data type itself, as in the published archetype of the Occupational Health Assessment Summary, not through a term_binding section. Three things are recorded as the source has them and are not smoothed over. First, the clinical criterion of a disease may be unnumbered in the ordinance itself - scarlet fever is such a case - so CRITERION.CODE is optional and such a criterion carries only its text; this is not a gap in the model but the source stated exactly. Second, APPLIED.RULE is an uncoded string: it is the expression the system computed with, and there is no nomenclature to bind it to. Third, the coding of SEX is not documented anywhere in the source - neither in the database nor in the system that writes it - so the value travels as the code of that system, with no terminology named. No binding to SNOMED CT or LOINC is made anywhere in this archetype.">
            misuse = <"Not to be read as a terminology-bound record: three of the four coding schemes are national annexes of an ordinance, not registered international terminologies.">
            keywords = <"infectious disease", "case notification", "case classification", "Ordinance No 21", "EN ISO 13606">
            copyright = <"ISO/CEN 13606">
        >
    >

definition
    COMPOSITION[at0000] occurrences matches {1..1} matches {  -- InfectiousDiseaseCaseNotification
        content existence matches {1..1} cardinality matches {0..*; unordered} matches {
            SECTION[at0001] occurrences matches {0..*} matches {  -- SECTION-SUBJECT
                members existence matches {0..1} cardinality matches {0..*; unordered; unique} matches {
                    ENTRY[at0002] occurrences matches {0..*} matches {  -- ENTRY-PERSON
                        items existence matches {0..1} cardinality matches {0..*; unordered; unique} matches {
                            ELEMENT[at0003] occurrences matches {0..*} matches {  -- SUBJECT.ID
                                value existence matches {0..1} matches {
                                    II[at0004] occurrences matches {0..1} matches {  -- II
                                        extension existence matches {0..1} matches {/.*/}
                                    }
                                }
                            }
                            ELEMENT[at0005] occurrences matches {0..*} matches {  -- BIRTH.DATE
                                value existence matches {0..1} matches {
                                    DATE[at0006] occurrences matches {0..1} matches {  -- DATE
                                        date existence matches {1..1} matches {/.*/}
                                    }
                                }
                            }
                            ELEMENT[at0007] occurrences matches {0..*} matches {  -- SEX
                                value existence matches {0..1} matches {
