                                            }
                                        }
                                    }
                                    ELEMENT[at0033] occurrences matches {0..*} matches {  -- CRITERION.TEXT
                                        value existence matches {0..1} matches {
                                            SIMPLE_TEXT[at0034] occurrences matches {0..1} matches {  -- SIMPLE_TEXT
                                                originalText existence matches {0..1} matches {/.*/}
                                            }
                                        }
                                    }
                                }
                                structure_type existence matches {1..1} matches {
                                    CS[at0028] occurrences matches {1..1} matches {  -- STRUCTURE_TYPE
                                        codeValue existence matches {0..1} matches {"STRC01"}
                                        codingSchemeName existence matches {0..1} matches {"CEN/TC251/EN13606-3:STRUCTURE_TYPE"}
                                    }
                                }
                            }
                        }
                    }
                }
            }
            SECTION[at0035] occurrences matches {0..*} matches {  -- SECTION-REPORTER
                members existence matches {0..1} cardinality matches {0..*; unordered; unique} matches {
                    ENTRY[at0036] occurrences matches {0..*} matches {  -- ENTRY-REPORTER
                        items existence matches {0..1} cardinality matches {0..*; unordered; unique} matches {
                            ELEMENT[at0037] occurrences matches {0..*} matches {  -- REPORTER.NAME
                                value existence matches {0..1} matches {
                                    SIMPLE_TEXT[at0038] occurrences matches {0..1} matches {  -- SIMPLE_TEXT
                                        originalText existence matches {0..1} matches {/.*/}
                                    }
                                }
                            }
                            ELEMENT[at0039] occurrences matches {0..*} matches {  -- REPORTER.WORKPLACE
                                value existence matches {0..1} matches {
                                    SIMPLE_TEXT[at0040] occurrences matches {0..1} matches {  -- SIMPLE_TEXT
                                        originalText existence matches {0..1} matches {/.*/}
                                    }
                                }
                            }
                            ELEMENT[at0041] occurrences matches {0..*} matches {  -- NOTIFICATION.DATE
                                value existence matches {0..1} matches {
                                    DATE[at0042] occurrences matches {0..1} matches {  -- DATE
                                        date existence matches {1..1} matches {/.*/}
                                    }
                                }
                            }
