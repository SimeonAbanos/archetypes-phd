                        items existence matches {0..1} cardinality matches {0..*; unordered; unique} matches {
                            ELEMENT[at0019] occurrences matches {0..*} matches {  -- CASE.CLASS
                                value existence matches {0..1} matches {
                                    CD[at0020] occurrences matches {0..1} matches {  -- CD
                                        codeValue existence matches {0..1} matches {/.*/}
                                        codingSchemeName existence matches {0..1} matches {"NAREDBA21-PRIL2"}
                                    }
                                }
                            }
                            ELEMENT[at0021] occurrences matches {0..1} matches {  -- CLASSIFICATION.CONTEXT
                                value existence matches {0..1} matches {
                                    SIMPLE_TEXT[at0022] occurrences matches {0..1} matches {  -- SIMPLE_TEXT
                                        originalText existence matches {0..1} matches {/.*/}
                                    }
                                }
                            }
                            ELEMENT[at0023] occurrences matches {0..*} matches {  -- APPLIED.RULE
                                value existence matches {0..1} matches {
                                    SIMPLE_TEXT[at0024] occurrences matches {0..1} matches {  -- SIMPLE_TEXT
                                        originalText existence matches {0..1} matches {/.*/}
                                    }
                                }
                            }
                            ELEMENT[at0025] occurrences matches {0..*} matches {  -- CLASSIFICATION.DATE
                                value existence matches {0..1} matches {
                                    DATE[at0026] occurrences matches {0..1} matches {  -- DATE
                                        date existence matches {1..1} matches {/.*/}
                                    }
                                }
                            }
                            CLUSTER[at0027] occurrences matches {1..*} matches {  -- GROUNDS
                                parts existence matches {0..1} cardinality matches {0..*; unordered; unique} matches {
                                    ELEMENT[at0029] occurrences matches {0..*} matches {  -- CRITERION.CATEGORY
                                        value existence matches {0..1} matches {
                                            CD[at0030] occurrences matches {0..1} matches {  -- CD
                                                codeValue existence matches {0..1} matches {/.*/}
                                                codingSchemeName existence matches {0..1} matches {"NAREDBA21-PRIL3"}
                                            }
                                        }
                                    }
                                    ELEMENT[at0031] occurrences matches {0..1} matches {  -- CRITERION.CODE
                                        value existence matches {0..1} matches {
